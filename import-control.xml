<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC
    "-//Checkstyle//DTD ImportControl Configuration 1.4//EN"
    "https://checkstyle.org/dtds/import_control_1_4.dtd">
<import-control pkg="com.connorjensen.griddlers">
  <!-- Global rules -->
  <disallow pkg="java" regex="true"/>
  <disallow pkg="org\.junit\.jupiter" regex="true"/>
  <disallow pkg="com\.connorjensen\.griddlers\.tools" regex="true"/>
  <allow pkg="com\.connorjensen\.griddlers\.model" regex="true"/>
  <allow pkg="java\.util" regex="true"/>

  <!-- Test files, allow them to use junit -->
  <file name=".*Test" regex="true">
    <allow pkg="org\.junit\.jupiter" regex="true"/>
  </file>

  <!-- Model should be able to inherit from engine, and itself, no others. -->
  <subpackage name="model">
    <disallow pkg="com\.connorjensen\.griddlers" regex="true"/>
    <allow pkg="com\.connorjensen\.griddlers\.model" regex="true"/>
    <allow pkg="java\.util" regex="true"/>
  </subpackage>

  <subpackage name="engine">
    <allow pkg="com\.connorjensen\.griddlers\.model" regex="true"/>
  </subpackage>

  <!-- ./tools should be able to use most/all resources, keeping unblocked right now  -->
  <subpackage name="tools">
    <allow pkg="com\.connorjensen\.griddlers" regex="true"/>
    <allow pkg="java" regex="true"/>
  </subpackage>
</import-control>
