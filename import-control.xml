<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC
    "-//Checkstyle//DTD ImportControl Configuration 1.4//EN"
    "https://checkstyle.org/dtds/import_control_1_4.dtd">

<!--
  The dependency direction, top to bottom: tools -> engine -> model.

  Nothing here is a blanket ban. `strategyOnMismatch` on <import-control> defaults
  to "disallowed", so an import that no rule mentions is already refused; every
  line below is a permission rather than a prohibition.

  Order matters twice over. Within a node, the first rule that matches an import
  wins. Across nodes, the first child that claims a file wins - which is why the
  <subpackage> blocks are declared before the root's <file> block, and not after.
-->
<import-control pkg="com.connorjensen.griddlers">

  <!-- The root package holds Main, the composition root. Wiring the program
       together is its whole job, so it is the one place that may reach tools. -->
  <allow pkg="com\.connorjensen\.griddlers\.tools" regex="true"/>
  <allow pkg="java\.util" regex="true"/>

  <!-- The model is the bottom layer: plain data that depends on nothing of ours.
       strategyOnMismatch stops it inheriting the root's reach into tools. -->
  <subpackage name="model" strategyOnMismatch="disallowed">
    <allow pkg="java\.util" regex="true"/>

    <file name=".*Test" regex="true">
      <allow pkg="org\.junit\.jupiter" regex="true"/>
    </file>
  </subpackage>

  <!-- The engine computes. It may use the model and plain data types, and may
       never reach tools, a file, a socket, or a stream. -->
  <subpackage name="engine" strategyOnMismatch="disallowed">
    <allow pkg="com\.connorjensen\.griddlers\.model" regex="true"/>
    <allow pkg="java\.util" regex="true"/>

    <file name=".*Test" regex="true">
      <allow pkg="org\.junit\.jupiter" regex="true"/>
    </file>
  </subpackage>

  <!-- Tools is the I/O layer, and the only place that may reach a file. -->
  <subpackage name="tools">
    <allow pkg="com\.connorjensen\.griddlers\.engine" regex="true"/>
    <allow pkg="com\.connorjensen\.griddlers\.model" regex="true"/>
    <allow pkg="java" regex="true"/>

    <file name=".*Test" regex="true">
      <allow pkg="org\.junit\.jupiter" regex="true"/>
    </file>
  </subpackage>

  <!-- Tests in the root package. Declared last so it cannot claim a file that
       belongs to one of the subpackages above. -->
  <file name=".*Test" regex="true">
    <allow pkg="org\.junit\.jupiter" regex="true"/>
  </file>

</import-control>
